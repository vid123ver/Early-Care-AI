## Backend environment variables (DO NOT COMMIT your real .env)
#
# Local Docker example:
# MONGO_URI=mongodb://mongo:27017/
#
# Production example for Render / Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/earlycare?retryWrites=true&w=majority
MONGO_URI=

# JWT signing secret (set a long random value in production)
JWT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-1.5-flash
FRONTEND_ORIGIN=http://localhost:5177
